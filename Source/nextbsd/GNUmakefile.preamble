# Additional flags to pass to the preprocessor
ADDITIONAL_CPPFLAGS += -Wall $(CONFIG_SYSTEM_DEFS)

# Additional include directories the compiler should search.
# GRAPHIC_CFLAGS carries the WindowServerClient flags from pkgconf.
ADDITIONAL_INCLUDE_DIRS += -I../../Headers \
	-I../$(GNUSTEP_TARGET_DIR) $(GRAPHIC_CFLAGS)

# OpenGL (NextBSDOpenGL.h) builds when the EGL and GBM headers are there;
# the libraries are loaded at run time, so nothing is linked.
ADDITIONAL_INCLUDE_DIRS += $(shell pkg-config --cflags-only-I egl gbm 2>/dev/null)
